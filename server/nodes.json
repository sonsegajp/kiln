{
  "_comment": "Kiln node catalog, in ComfyUI object_info shape. The engine implements exactly these class_types. COMBO lists written as \"$name\" are filled by the server at /api/nodes: $diffusion_models, $text_encoders, $vaes, $loras, $upscale_models, $bbox_models, $samplers, $schedulers, $images.",

  "UNETLoader": {
    "display_name": "Load Diffusion Model", "category": "loaders",
    "input": {"required": {"unet_name": ["$diffusion_models"], "weight_dtype": [["default", "fp8_e4m3fn", "fp8_e4m3fn_fast", "fp8_e5m2"], {"default": "default", "tooltip": "ignored: Kiln stores weights as bf16"}]}},
    "output": ["MODEL"], "output_name": ["MODEL"]
  },
  "UnetLoaderGGUF": {
    "display_name": "Unet Loader (GGUF)", "category": "loaders", "kiln_note": "compat: loads the Anima safetensors checkpoint with the same base name if present, else the default checkpoint",
    "input": {"required": {"unet_name": ["$diffusion_models"]}},
    "output": ["MODEL"], "output_name": ["MODEL"]
  },
  "CLIPLoader": {
    "display_name": "Load CLIP", "category": "loaders",
    "input": {"required": {"clip_name": ["$text_encoders"], "type": [["stable_diffusion", "sd3", "stable_audio", "wan", "hidream", "chroma", "ace", "omnigen2", "qwen_image", "hunyuan_image", "flux2", "ovis", "lumina2", "cosmos"], {"default": "stable_diffusion", "tooltip": "ignored: Kiln detects the Anima Qwen3 text encoder"}]},
              "optional": {"device": [["default", "cpu"], {"default": "default"}]}},
    "output": ["CLIP"], "output_name": ["CLIP"]
  },
  "VAELoader": {
    "display_name": "Load VAE", "category": "loaders",
    "input": {"required": {"vae_name": ["$vaes"]}},
    "output": ["VAE"], "output_name": ["VAE"]
  },
  "LoraLoaderModelOnly": {
    "display_name": "LoraLoaderModelOnly", "category": "loaders",
    "input": {"required": {"model": ["MODEL"], "lora_name": ["$loras"], "strength_model": ["FLOAT", {"default": 1.0, "min": -100.0, "max": 100.0, "step": 0.01}]}},
    "output": ["MODEL"], "output_name": ["MODEL"]
  },
  "LoraLoader": {
    "display_name": "Load LoRA", "category": "loaders", "kiln_note": "strength_clip is ignored (Anima LoRAs are model-only)",
    "input": {"required": {"model": ["MODEL"], "clip": ["CLIP"], "lora_name": ["$loras"],
                            "strength_model": ["FLOAT", {"default": 1.0, "min": -100.0, "max": 100.0, "step": 0.01}],
                            "strength_clip": ["FLOAT", {"default": 1.0, "min": -100.0, "max": 100.0, "step": 0.01}]}},
    "output": ["MODEL", "CLIP"], "output_name": ["MODEL", "CLIP"]
  },
  "UpscaleModelLoader": {
    "display_name": "Load Upscale Model", "category": "loaders",
    "input": {"required": {"model_name": ["$upscale_models"]}},
    "output": ["UPSCALE_MODEL"], "output_name": ["UPSCALE_MODEL"]
  },
  "UltralyticsDetectorProvider": {
    "display_name": "UltralyticsDetectorProvider", "category": "ImpactPack",
    "input": {"required": {"model_name": ["$bbox_models"]}},
    "output": ["BBOX_DETECTOR", "SEGM_DETECTOR"], "output_name": ["BBOX_DETECTOR", "SEGM_DETECTOR"]
  },

  "ModelSamplingAuraFlow": {
    "display_name": "ModelSamplingAuraFlow", "category": "advanced/model",
    "input": {"required": {"model": ["MODEL"], "shift": ["FLOAT", {"default": 1.73, "min": 0.0, "max": 100.0, "step": 0.01}]}},
    "output": ["MODEL"], "output_name": ["MODEL"]
  },
  "ModelSamplingSD3": {
    "display_name": "ModelSamplingSD3", "category": "advanced/model",
    "input": {"required": {"model": ["MODEL"], "shift": ["FLOAT", {"default": 3.0, "min": 0.0, "max": 100.0, "step": 0.01}]}},
    "output": ["MODEL"], "output_name": ["MODEL"]
  },
  "ApplyFBCacheOnModel": {
    "display_name": "Apply First Block Cache", "category": "wavespeed", "kiln_note": "Kiln's step cache; start/end are fractions of the steps",
    "input": {"required": {"model": ["MODEL"], "object_to_patch": ["STRING", {"default": "diffusion_model"}],
                            "residual_diff_threshold": ["FLOAT", {"default": 0.1, "min": 0.0, "max": 1.0, "step": 0.001}],
                            "start": ["FLOAT", {"default": 0.15, "min": 0.0, "max": 1.0, "step": 0.01}],
                            "end": ["FLOAT", {"default": 0.9, "min": 0.0, "max": 1.0, "step": 0.01}],
                            "max_consecutive_cache_hits": ["INT", {"default": 2, "min": -1, "max": 100}]}},
    "output": ["MODEL"], "output_name": ["MODEL"]
  },

  "CLIPTextEncode": {
    "display_name": "CLIP Text Encode (Prompt)", "category": "conditioning",
    "input": {"required": {"text": ["STRING", {"multiline": true, "dynamicPrompts": true}], "clip": ["CLIP"]}},
    "output": ["CONDITIONING"], "output_name": ["CONDITIONING"]
  },

  "EmptySD3LatentImage": {
    "display_name": "EmptySD3LatentImage", "category": "latent/sd3",
    "input": {"required": {"width": ["INT", {"default": 1024, "min": 16, "max": 16384, "step": 16}], "height": ["INT", {"default": 1024, "min": 16, "max": 16384, "step": 16}], "batch_size": ["INT", {"default": 1, "min": 1, "max": 4096}]}},
    "output": ["LATENT"], "output_name": ["LATENT"]
  },
  "EmptyLatentImage": {
    "display_name": "Empty Latent Image", "category": "latent",
    "input": {"required": {"width": ["INT", {"default": 512, "min": 16, "max": 16384, "step": 8}], "height": ["INT", {"default": 512, "min": 16, "max": 16384, "step": 8}], "batch_size": ["INT", {"default": 1, "min": 1, "max": 4096}]}},
    "output": ["LATENT"], "output_name": ["LATENT"]
  },
  "VAEEncode": {
    "display_name": "VAE Encode", "category": "latent",
    "input": {"required": {"pixels": ["IMAGE"], "vae": ["VAE"]}},
    "output": ["LATENT"], "output_name": ["LATENT"]
  },
  "VAEDecode": {
    "display_name": "VAE Decode", "category": "latent",
    "input": {"required": {"samples": ["LATENT"], "vae": ["VAE"]}},
    "output": ["IMAGE"], "output_name": ["IMAGE"]
  },
  "SetLatentNoiseMask": {
    "display_name": "Set Latent Noise Mask", "category": "latent/inpaint",
    "input": {"required": {"samples": ["LATENT"], "mask": ["MASK"]}},
    "output": ["LATENT"], "output_name": ["LATENT"]
  },
  "LatentUpscale": {
    "display_name": "Upscale Latent", "category": "latent",
    "input": {"required": {"samples": ["LATENT"], "upscale_method": [["nearest-exact", "bilinear", "area", "bicubic", "bislerp"]],
                            "width": ["INT", {"default": 512, "min": 0, "max": 16384, "step": 8}], "height": ["INT", {"default": 512, "min": 0, "max": 16384, "step": 8}],
                            "crop": [["disabled", "center"]]}},
    "output": ["LATENT"], "output_name": ["LATENT"]
  },
  "LatentUpscaleBy": {
    "display_name": "Upscale Latent By", "category": "latent",
    "input": {"required": {"samples": ["LATENT"], "upscale_method": [["nearest-exact", "bilinear", "area", "bicubic", "bislerp"]],
                            "scale_by": ["FLOAT", {"default": 1.5, "min": 0.01, "max": 8.0, "step": 0.01}]}},
    "output": ["LATENT"], "output_name": ["LATENT"]
  },

  "KSampler": {
    "display_name": "KSampler", "category": "sampling",
    "input": {"required": {"model": ["MODEL"], "seed": ["INT", {"default": 0, "min": 0, "max": 18446744073709551615, "control_after_generate": true}],
                            "steps": ["INT", {"default": 20, "min": 1, "max": 10000}], "cfg": ["FLOAT", {"default": 8.0, "min": 0.0, "max": 100.0, "step": 0.1}],
                            "sampler_name": ["$samplers"], "scheduler": ["$schedulers"],
                            "positive": ["CONDITIONING"], "negative": ["CONDITIONING"], "latent_image": ["LATENT"],
                            "denoise": ["FLOAT", {"default": 1.0, "min": 0.0, "max": 1.0, "step": 0.01}]}},
    "output": ["LATENT"], "output_name": ["LATENT"]
  },
  "KSamplerAdvanced": {
    "display_name": "KSampler (Advanced)", "category": "sampling",
    "input": {"required": {"model": ["MODEL"], "add_noise": [["enable", "disable"]],
                            "noise_seed": ["INT", {"default": 0, "min": 0, "max": 18446744073709551615, "control_after_generate": true}],
                            "steps": ["INT", {"default": 20, "min": 1, "max": 10000}], "cfg": ["FLOAT", {"default": 8.0, "min": 0.0, "max": 100.0, "step": 0.1}],
                            "sampler_name": ["$samplers"], "scheduler": ["$schedulers"],
                            "positive": ["CONDITIONING"], "negative": ["CONDITIONING"], "latent_image": ["LATENT"],
                            "start_at_step": ["INT", {"default": 0, "min": 0, "max": 10000}], "end_at_step": ["INT", {"default": 10000, "min": 0, "max": 10000}],
                            "return_with_leftover_noise": [["disable", "enable"]]}},
    "output": ["LATENT"], "output_name": ["LATENT"]
  },
  "KSamplerWithNAG": {
    "display_name": "KSamplerWithNAG", "category": "sampling", "kiln_note": "ComfyUI-NAG: negative prompt without CFG",
    "input": {"required": {"model": ["MODEL"], "seed": ["INT", {"default": 0, "min": 0, "max": 18446744073709551615, "control_after_generate": true}],
                            "steps": ["INT", {"default": 20, "min": 1, "max": 10000}], "cfg": ["FLOAT", {"default": 1.0, "min": 0.0, "max": 100.0, "step": 0.1}],
                            "nag_scale": ["FLOAT", {"default": 5.0, "min": 0.0, "max": 100.0, "step": 0.1}],
                            "nag_tau": ["FLOAT", {"default": 2.5, "min": 1.0, "max": 10.0, "step": 0.01}],
                            "nag_alpha": ["FLOAT", {"default": 0.25, "min": 0.0, "max": 1.0, "step": 0.01}],
                            "nag_sigma_end": ["FLOAT", {"default": 0.0, "min": 0.0, "max": 20.0, "step": 0.01}],
                            "sampler_name": ["$samplers"], "scheduler": ["$schedulers"],
                            "positive": ["CONDITIONING"], "negative": ["CONDITIONING"], "nag_negative": ["CONDITIONING"],
                            "latent_image": ["LATENT"], "denoise": ["FLOAT", {"default": 1.0, "min": 0.0, "max": 1.0, "step": 0.01}]}},
    "output": ["LATENT"], "output_name": ["LATENT"]
  },

  "LoadImage": {
    "display_name": "Load Image", "category": "image",
    "input": {"required": {"image": ["$images", {"image_upload": true}]}},
    "output": ["IMAGE", "MASK"], "output_name": ["IMAGE", "MASK"]
  },
  "SaveImage": {
    "display_name": "Save Image", "category": "image", "output_node": true,
    "input": {"required": {"images": ["IMAGE"], "filename_prefix": ["STRING", {"default": "Kiln"}]}},
    "output": [], "output_name": []
  },
  "PreviewImage": {
    "display_name": "Preview Image", "category": "image", "output_node": true,
    "input": {"required": {"images": ["IMAGE"]}},
    "output": [], "output_name": []
  },
  "ImageScale": {
    "display_name": "Upscale Image", "category": "image/upscaling",
    "input": {"required": {"image": ["IMAGE"], "upscale_method": [["nearest-exact", "bilinear", "area", "bicubic", "lanczos"]],
                            "width": ["INT", {"default": 512, "min": 0, "max": 16384, "step": 1}], "height": ["INT", {"default": 512, "min": 0, "max": 16384, "step": 1}],
                            "crop": [["disabled", "center"]]}},
    "output": ["IMAGE"], "output_name": ["IMAGE"]
  },
  "ImageScaleBy": {
    "display_name": "Upscale Image By", "category": "image/upscaling",
    "input": {"required": {"image": ["IMAGE"], "upscale_method": [["nearest-exact", "bilinear", "area", "bicubic", "lanczos"]],
                            "scale_by": ["FLOAT", {"default": 1.0, "min": 0.01, "max": 8.0, "step": 0.01}]}},
    "output": ["IMAGE"], "output_name": ["IMAGE"]
  },
  "ImageUpscaleWithModel": {
    "display_name": "Upscale Image (using Model)", "category": "image/upscaling",
    "input": {"required": {"upscale_model": ["UPSCALE_MODEL"], "image": ["IMAGE"]}},
    "output": ["IMAGE"], "output_name": ["IMAGE"]
  },

  "FaceDetailer": {
    "display_name": "FaceDetailer", "category": "ImpactPack/Simple", "kiln_note": "bbox detection only (SAM options are accepted and ignored)",
    "input": {"required": {
        "image": ["IMAGE"], "model": ["MODEL"], "clip": ["CLIP"], "vae": ["VAE"],
        "guide_size": ["FLOAT", {"default": 512, "min": 64, "max": 8192, "step": 8}],
        "guide_size_for": ["BOOLEAN", {"default": true, "label_on": "bbox", "label_off": "crop_region"}],
        "max_size": ["FLOAT", {"default": 1024, "min": 64, "max": 8192, "step": 8}],
        "seed": ["INT", {"default": 0, "min": 0, "max": 18446744073709551615, "control_after_generate": true}],
        "steps": ["INT", {"default": 20, "min": 1, "max": 10000}], "cfg": ["FLOAT", {"default": 8.0, "min": 0.0, "max": 100.0, "step": 0.1}],
        "sampler_name": ["$samplers"], "scheduler": ["$schedulers"],
        "positive": ["CONDITIONING"], "negative": ["CONDITIONING"],
        "denoise": ["FLOAT", {"default": 0.5, "min": 0.0001, "max": 1.0, "step": 0.01}],
        "feather": ["INT", {"default": 5, "min": 0, "max": 100, "step": 1}],
        "noise_mask": ["BOOLEAN", {"default": true}], "force_inpaint": ["BOOLEAN", {"default": true}],
        "bbox_threshold": ["FLOAT", {"default": 0.5, "min": 0.0, "max": 1.0, "step": 0.01}],
        "bbox_dilation": ["INT", {"default": 10, "min": -512, "max": 512, "step": 1}],
        "bbox_crop_factor": ["FLOAT", {"default": 3.0, "min": 1.0, "max": 10.0, "step": 0.1}],
        "sam_detection_hint": [["center-1", "horizontal-2", "vertical-2", "rect-4", "diamond-4", "mask-area", "mask-points", "mask-point-bbox", "none"]],
        "sam_dilation": ["INT", {"default": 0, "min": -512, "max": 512}], "sam_threshold": ["FLOAT", {"default": 0.93, "min": 0.0, "max": 1.0, "step": 0.01}],
        "sam_bbox_expansion": ["INT", {"default": 0, "min": 0, "max": 1000}], "sam_mask_hint_threshold": ["FLOAT", {"default": 0.7, "min": 0.0, "max": 1.0, "step": 0.01}],
        "sam_mask_hint_use_negative": [["False", "Small", "Outter"]],
        "drop_size": ["INT", {"default": 10, "min": 1, "max": 8192}],
        "bbox_detector": ["BBOX_DETECTOR"],
        "wildcard": ["STRING", {"multiline": true}],
        "cycle": ["INT", {"default": 1, "min": 1, "max": 10}]},
      "optional": {"sam_model_opt": ["SAM_MODEL"], "segm_detector_opt": ["SEGM_DETECTOR"], "detailer_hook": ["DETAILER_HOOK"], "inpaint_model": ["BOOLEAN", {"default": false}],
                   "noise_mask_feather": ["INT", {"default": 20, "min": 0, "max": 100}], "tiled_encode": ["BOOLEAN", {"default": false}], "tiled_decode": ["BOOLEAN", {"default": false}]}},
    "output": ["IMAGE", "IMAGE", "IMAGE", "MASK", "DETAILER_PIPE", "IMAGE"],
    "output_name": ["image", "cropped_refined", "cropped_enhanced_alpha", "mask", "detailer_pipe", "cnet_images"]
  }
}
